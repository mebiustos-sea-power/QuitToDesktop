<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#C0000000" Panel.ZIndex="2147483647"
      KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
    <Grid.Resources>
        <Style x:Key="QuitDialogButton" TargetType="Button">
            <Setter Property="Background" Value="#263B49"/>
            <Setter Property="Foreground" Value="#F1F4F5"/>
            <Setter Property="BorderBrush" Value="#71858D"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonFrame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonFrame" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonFrame" Property="BorderBrush" Value="#F5C36A"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonFrame" Property="Opacity" Value="0.6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Grid.Resources>
    <Border x:Name="DialogCard" Width="600" MaxWidth="600" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="#15232D" BorderBrush="#7A8A91" BorderThickness="1">
        <StackPanel>
            <Border Background="#F0B85A" Padding="22,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Width="30" Height="28" HorizontalAlignment="Left">
                        <Path Data="M 15,0 L 30,28 L 0,28 Z" Fill="#20262A"/>
                        <TextBlock Text="!" FontSize="19" FontWeight="Bold" Foreground="#F0B85A" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                    </Grid>
                    <TextBlock x:Name="DialogCategory" Grid.Column="1" Foreground="#20262A" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
            </Border>
            <StackPanel Margin="24,22,24,24">
                <TextBlock x:Name="DialogTitle" FontSize="27" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                <TextBlock x:Name="DialogMessage" Margin="0,18,0,0" FontSize="18" Foreground="#E0E7EB" TextWrapping="Wrap"/>
                <TextBlock x:Name="DialogWarning" Margin="0,14,0,0" FontSize="16" Foreground="#F5C36A" TextWrapping="Wrap"/>
                <Grid Margin="0,26,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="CancelQuit" Style="{StaticResource QuitDialogButton}"/>
                    <Button x:Name="ConfirmQuit" Grid.Column="2" Style="{StaticResource QuitDialogButton}" Background="#773F37" BorderBrush="#BC8373"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Grid>
